# Copy to local.env (gitignored) and fill in — read by `npm run dev` (scripts/start-dev.mjs),
# which patches src/environments/environment.ts and restores it on exit.
# Every key is optional: environment.ts ships working defaults. NEVER commit real values.
# Production builds don't read this file — Vercel env vars feed scripts/patch-env.mjs (see README).

# Local backend (underagegiant-travelbestie-manager `npm run dev`)
BACKEND_API_URL=http://localhost:3000
# true = skip the backend entirely and use in-memory mock data
BACKEND_USE_MOCKS=false
# Public half of the backend's RSA key pair — only if your local backend uses a different pair
# BACKEND_RSA_PUBLIC_KEY=
# Cloudflare Turnstile site key — environment.ts defaults to the always-pass test key
# TURNSTILE_SITE_KEY=
# Trip autosave interval in milliseconds
# AUTOSAVE_INTERVAL_MS=
