{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/underagegiant-travelbestie-frontend/browser",
  "framework": null,
  "rewrites": [
    { "source": "/es-CL/((?!assets|favicon).*)", "destination": "/es-CL/index.html" },
    { "source": "/en-US/((?!assets|favicon).*)", "destination": "/en-US/index.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
