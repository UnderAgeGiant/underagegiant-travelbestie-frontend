      <!-- ── region labels (city.model.ts via $localize) ── -->
      <trans-unit id="region.europe" datatype="html">
        <source>Europa</source>
        <target>Europe</target>
      </trans-unit>
      <trans-unit id="region.asia" datatype="html">
        <source>Asia</source>
        <target>Asia</target>
      </trans-unit>
      <trans-unit id="region.americas" datatype="html">
        <source>América</source>
        <target>Americas</target>
      </trans-unit>
      <trans-unit id="region.africa" datatype="html">
        <source>África</source>
        <target>Africa</target>
      </trans-unit>
      <trans-unit id="region.oceania" datatype="html">
        <source>Oceanía</source>
