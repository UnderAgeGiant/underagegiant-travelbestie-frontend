        <source>dd/mm/aaaa</source>
        <target>mm/dd/yyyy</target>
      </trans-unit>
      <trans-unit id="datePicker.toPlaceholder" datatype="html">
        <source>dd/mm/aaaa</source>
        <target>mm/dd/yyyy</target>
      </trans-unit>

      <!-- ── city-combobox.component ── -->
      <trans-unit id="combobox.placeholder" datatype="html">
        <source>Buscar ciudad o país…</source>
        <target>Search city or country…</target>
      </trans-unit>
      <trans-unit id="combobox.searchPlaceholder" datatype="html">
        <source>Escribe para buscar…</source>
        <target>Type to search…</target>
