        <source>Busca entre 120+ ciudades del mundo</source>
        <target>Search from 120+ cities worldwide</target>
      </trans-unit>
      <trans-unit id="addStop.cityLabel" datatype="html">
        <source>Ciudad</source>
        <target>City</target>
      </trans-unit>
      <trans-unit id="addStop.checkInLabel" datatype="html">
        <source>Entrada</source>
        <target>Check-in</target>
      </trans-unit>
      <trans-unit id="addStop.checkOutLabel" datatype="html">
        <source>Salida</source>
        <target>Check-out</target>
      </trans-unit>
      <trans-unit id="addStop.cancelBtn" datatype="html">
        <source>Cancelar</source>
        <target>Cancel</target>
      </trans-unit>
      <trans-unit id="addStop.addBtn" datatype="html">
        <source>Agregar al viaje ✈️</source>
        <target>Add to Trip ✈️</target>
      </trans-unit>

