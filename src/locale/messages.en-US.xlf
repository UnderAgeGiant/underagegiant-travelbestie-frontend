      <trans-unit id="stopList.title" datatype="html">
        <source>Mi viaje ✈️</source>
        <target>My Trip ✈️</target>
      </trans-unit>
      <trans-unit id="stopList.noStops" datatype="html">
        <source>Agrega tu primer destino</source>
        <target>Add your first destination</target>
      </trans-unit>
      <trans-unit id="stopList.oneStopPlanned" datatype="html">
        <source>destino planificado</source>
        <target>destination planned</target>
      </trans-unit>
      <trans-unit id="stopList.manyStopsPlanned" datatype="html">
        <source>destinos planificados</source>
        <target>destinations planned</target>
      </trans-unit>
      <trans-unit id="stopList.emptyLine1" datatype="html">
        <source>Busca una ciudad arriba</source>
        <target>Search a city above</target>
      </trans-unit>
      <trans-unit id="stopList.emptyOr" datatype="html">
        <source>o haz clic en</source>
        <target>or click</target>
      </trans-unit>
      <trans-unit id="stopList.emptyAddBtn" datatype="html">
        <source>+ Agregar destino</source>
        <target>+ Add Destination</target>
      </trans-unit>
      <trans-unit id="stopList.checkInLabel" datatype="html">
        <source>Llegada</source>
        <target>In</target>
      </trans-unit>
      <trans-unit id="stopList.checkOutLabel" datatype="html">
        <source>Salida</source>
        <target>Out</target>
      </trans-unit>
