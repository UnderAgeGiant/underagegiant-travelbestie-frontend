<?xml version="1.0" encoding="UTF-8" ?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
  <file source-language="es-CL" target-language="en-US" datatype="plaintext" original="ng2.template">
    <body>

      <!-- ── app.component ── -->
      <trans-unit id="app.selectStop" datatype="html">
        <source>Selecciona una parada</source>
        <target>Select a stop</target>
      </trans-unit>
      <trans-unit id="app.selectStopDesc" datatype="html">
        <source>Haz clic en un destino del panel para explorar sus atracciones</source>
        <target>Click any destination in the panel to explore its attractions</target>
      </trans-unit>

      <!-- ── nav.component ── -->
      <trans-unit id="nav.searchPlaceholder" datatype="html">
        <source>Agregar ciudad…</source>
        <target>Quick-add a city…</target>
      </trans-unit>
      <trans-unit id="nav.quickAdd" datatype="html">
        <source>+ Agregar</source>
        <target>+ Add</target>
      </trans-unit>
      <trans-unit id="nav.oneStop" datatype="html">
        <source>parada</source>
        <target>stop</target>
      </trans-unit>
      <trans-unit id="nav.manyStops" datatype="html">
        <source>paradas</source>
        <target>stops</target>
      </trans-unit>
      <trans-unit id="nav.signInBtn" datatype="html">
        <source>Iniciar sesión</source>
        <target>Sign In</target>
      </trans-unit>
      <trans-unit id="nav.myAccount" datatype="html">
        <source>Mi cuenta</source>
        <target>My Account</target>
      </trans-unit>
      <trans-unit id="nav.signOut" datatype="html">
        <source>Cerrar sesión</source>
        <target>Sign out</target>
      </trans-unit>
      <trans-unit id="nav.loginTitle" datatype="html">
        <source>¡Bienvenido de vuelta! 👋</source>
        <target>Welcome back 👋</target>
      </trans-unit>
      <trans-unit id="nav.loginSubtitle" datatype="html">
        <source>Inicia sesión para guardar tus viajes</source>
        <target>Sign in to save your trips</target>
      </trans-unit>
      <trans-unit id="nav.registerTitle" datatype="html">
        <source>Crear cuenta ✨</source>
        <target>Create account ✨</target>
      </trans-unit>
      <trans-unit id="nav.registerSubtitle" datatype="html">
        <source>Únete y planifica viajes con tus amigos</source>
        <target>Join to plan trips with besties</target>
      </trans-unit>
      <trans-unit id="nav.nameLabel" datatype="html">
        <source>Tu nombre</source>
        <target>Your name</target>
      </trans-unit>
      <trans-unit id="nav.namePlaceholder" datatype="html">
        <source>Sofía García</source>
        <target>Sofia García</target>
      </trans-unit>
      <trans-unit id="nav.emailLabel" datatype="html">
        <source>Correo electrónico</source>
        <target>Email</target>
      </trans-unit>
      <trans-unit id="nav.emailPlaceholder" datatype="html">
        <source>tú@correo.com</source>
        <target>you@email.com</target>
      </trans-unit>
      <trans-unit id="nav.passwordLabel" datatype="html">
        <source>Contraseña</source>
        <target>Password</target>
      </trans-unit>
      <trans-unit id="nav.cancelBtn" datatype="html">
        <source>Cancelar</source>
        <target>Cancel</target>
      </trans-unit>
      <trans-unit id="nav.signInSubmit" datatype="html">
        <source>Iniciar sesión →</source>
        <target>Sign In →</target>
      </trans-unit>
      <trans-unit id="nav.registerSubmit" datatype="html">
        <source>Crear cuenta →</source>
        <target>Create Account →</target>
      </trans-unit>
      <trans-unit id="nav.authToggleLogin" datatype="html">
        <source>¿Sin cuenta? <x id="START_TAG_SPAN" ctype="x-span"/>Regístrate gratis<x id="CLOSE_TAG_SPAN" ctype="x-span"/></source>
        <target>No account? <x id="START_TAG_SPAN" ctype="x-span"/>Sign up free<x id="CLOSE_TAG_SPAN" ctype="x-span"/></target>
      </trans-unit>
      <trans-unit id="nav.authToggleRegister" datatype="html">
        <source>¿Ya tienes una? <x id="START_TAG_SPAN" ctype="x-span"/>Inicia sesión<x id="CLOSE_TAG_SPAN" ctype="x-span"/></source>
        <target>Already have one? <x id="START_TAG_SPAN" ctype="x-span"/>Sign in<x id="CLOSE_TAG_SPAN" ctype="x-span"/></target>
      </trans-unit>

      <!-- ── welcome.component ── -->
      <trans-unit id="welcome.eyebrow" datatype="html">
        <source>Planifica · Comparte · Explora</source>
        <target>Plan · Share · Explore</target>
      </trans-unit>
      <trans-unit id="welcome.title" datatype="html">
        <source>Viaja pensando en tu<x id="LINE_BREAK" ctype="lb"/><x id="START_TAG_EM" ctype="x-em"/>mejor amig@<x id="CLOSE_TAG_EM" ctype="x-em"/></source>
        <target>Travel with your<x id="LINE_BREAK" ctype="lb"/><x id="START_TAG_EM" ctype="x-em"/>bestie<x id="CLOSE_TAG_EM" ctype="x-em"/> in mind</target>
      </trans-unit>
      <trans-unit id="welcome.subtitle" datatype="html">
        <source>Crea viajes a múltiples destinos, descubre atracciones locales y deja que tus amigos comenten cada parada.</source>
        <target>Build multi-destination trips, discover local attractions, and let your friends leave comments on every stop.</target>
      </trans-unit>
      <trans-unit id="welcome.addBtn" datatype="html">
        <source>+ Agregar destino</source>
        <target>+ Add Destination</target>
      </trans-unit>
      <trans-unit id="welcome.step1Title" datatype="html">
        <source>Elige una ciudad</source>
        <target>Choose a city</target>
      </trans-unit>
      <trans-unit id="welcome.step1Desc" datatype="html">
        <source>120+ destinos en el mundo</source>
        <target>120+ destinations worldwide</target>
      </trans-unit>
      <trans-unit id="welcome.step2Title" datatype="html">
        <source>Explorar atracciones</source>
        <target>Explore attractions</target>
      </trans-unit>
      <trans-unit id="welcome.step2Desc" datatype="html">
        <source>Lugares seleccionados para ver y hacer</source>
        <target>Curated spots to see &amp; do</target>
      </trans-unit>
      <trans-unit id="welcome.step3Title" datatype="html">
        <source>Recopilar comentarios</source>
        <target>Collect comments</target>
      </trans-unit>
      <trans-unit id="welcome.step3Desc" datatype="html">
        <source>Tus amigos dejan consejos en cada parada</source>
        <target>Friends leave tips on each stop</target>
      </trans-unit>

