        <target>Book Trip 🎉</target>
      </trans-unit>

      <!-- ── add-stop-modal.component ── -->
      <trans-unit id="addStop.title" datatype="html">
        <source>Agregar destino ✈️</source>
        <target>Add a Destination ✈️</target>
      </trans-unit>
