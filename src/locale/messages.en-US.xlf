      <trans-unit id="dest.oneAttraction" datatype="html">
        <source>atracción</source>
        <target>attraction</target>
      </trans-unit>
      <trans-unit id="dest.manyAttractions" datatype="html">
        <source>atracciones</source>
        <target>attractions</target>
      </trans-unit>
      <trans-unit id="dest.oneComment" datatype="html">
        <source>comentario</source>
        <target>comment</target>
      </trans-unit>
      <trans-unit id="dest.manyComments" datatype="html">
        <source>comentarios</source>
        <target>comments</target>
      </trans-unit>
      <trans-unit id="dest.exploreTitle" datatype="html">
        <source>Explorar atracciones</source>
        <target>Explore Attractions</target>
      </trans-unit>
      <trans-unit id="dest.onePlace" datatype="html">
        <source>lugar</source>
        <target>place</target>
      </trans-unit>
      <trans-unit id="dest.manyPlaces" datatype="html">
        <source>lugares</source>
        <target>places</target>
      </trans-unit>

      <!-- ── attraction-card.component ── -->
      <trans-unit id="attCard.noComments" datatype="html">
        <source>¡Sin comentarios aún — sé el primero! 💬</source>
        <target>No comments yet — be the first! 💬</target>
      </trans-unit>
      <trans-unit id="attCard.more" datatype="html">
        <source>más</source>
        <target>more</target>
      </trans-unit>
      <trans-unit id="attCard.addComment" datatype="html">
