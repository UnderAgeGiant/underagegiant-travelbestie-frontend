        <target>Your experience</target>
      </trans-unit>
      <trans-unit id="commentModal.expPlaceholder" datatype="html">
        <source>¿Qué te encantó? ¿Algún consejo para tu amig&#64;?</source>
        <target>What did you love? Any tips for your bestie?</target>
      </trans-unit>
      <trans-unit id="commentModal.cancelBtn" datatype="html">
        <source>Cancelar</source>
        <target>Cancel</target>
      </trans-unit>
      <trans-unit id="commentModal.submitBtn" datatype="html">
        <source>Publicar comentario 💌</source>
        <target>Post Comment 💌</target>
      </trans-unit>

